<?xml version="1.0" encoding="utf-8"?>
<abapGit version="v1.0.0" serializer="LCL_OBJECT_CLAS" serializer_version="v1.0.0">
 <asx:abap xmlns:asx="http://www.sap.com/abapxml" version="1.0">
  <asx:values>
   <VSEOCLASS>
    <CLSNAME>ZCL_DDVE_VALUE_PRETTY_PRINTER</CLSNAME>
    <LANGU>E</LANGU>
    <DESCRIPT>Pretty Printer for ABAP Debugger Enhancement</DESCRIPT>
    <STATE>1</STATE>
    <CLSCCINCL>X</CLSCCINCL>
    <FIXPT>X</FIXPT>
    <UNICODE>X</UNICODE>
    <WITH_UNIT_TESTS>X</WITH_UNIT_TESTS>
   </VSEOCLASS>
   <DESCRIPTIONS>
    <SEOCOMPOTX>
     <CMPNAME>ADD_EMPTY_VALUE_OPERATOR</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>empty : &apos;VALUE #|typ( )&apos;</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>ADD_STRUCTURE_CONTENT</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>struct2 : ( LHS &apos;=&apos; RHS )+</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>ADD_STRUCTURE_RHS</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>struct : &apos;VALUE #|typ(&apos; struct2 &apos;)&apos;</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>ADD_TABLE</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>table : &apos;VALUE #|typ(&apos; ( &apos;( )&apos; | ( &apos;(&apos; inner_rhs &apos;)&apos; )+ ) &apos;)</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>ASSIGN</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>assign tries to build this: LHS = RHS</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>INNER_RHS</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT> inner_rhs : number | text | string | empty | struct2</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>LHS</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Left Hand Side of ASSIGNMENT aka LHS</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>RHS</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>RHS could be : number | text | string | empty | struct | tab</DESCRIPT>
    </SEOCOMPOTX>
   </DESCRIPTIONS>
  </asx:values>
 </asx:abap>
</abapGit>
